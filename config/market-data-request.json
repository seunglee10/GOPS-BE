{
  "description": "Default market-data universe and Alpaca subscription policy.",
  "defaultUniverse": "semiconductor-100",
  "defaultSymbols": [
    "NVDA", "AMD", "AVGO", "INTC", "QCOM", "TXN", "MU", "ADI", "MRVL", "MCHP",
    "MPWR", "ON", "NXPI", "SWKS", "QRVO", "LSCC", "ALGM", "DIOD", "CRUS", "POWI",
    "SLAB", "SIMO", "HIMX", "AMBA", "CEVA", "RMBS", "MTSI", "AOSL", "MXL", "SYNA",
    "SMTC", "SGH", "SITM", "PI", "LASR", "IPGP", "COHR", "LITE", "WOLF", "NVTS",
    "CRDO", "ALAB", "MRAM", "GSIT", "ATOM", "QUIK", "PXLW", "INDI", "SKYT", "TSM",
    "UMC", "GFS", "ASX", "STM", "ARM", "ASML", "AMAT", "LRCX", "KLAC", "TER",
    "ONTO", "MKSI", "ENTG", "UCTT", "ICHR", "VECO", "ACMR", "NVMI", "CAMT", "COHU",
    "FORM", "KLIC", "AEHR", "ACLS", "AMKR", "PLAB", "TSEM", "IMOS", "SNPS", "CDNS",
    "ASYS", "INTT", "AXTI", "WDC", "STX", "KEYS", "OSIS", "NVEC", "OLED", "FN",
    "FLEX", "SANM", "JBL", "CLS", "VSH", "VICR", "BELFB", "CTS", "MEI", "ARW"
  ],
  "defaultChannels": ["bars", "updatedBars"],
  "activeChartChannels": ["trades"],
  "validChannels": ["bars", "updatedBars", "trades"],
  "symbolPattern": "^[A-Z][A-Z0-9]{0,9}(\\.[A-Z])?$",
  "dataPolicy": {
    "s3FinalThrough": "previous-trading-day",
    "initialChartLoad": "today-1m-bars-plus-recent-clickhouse-history",
    "avoidInitialTodayTickReplay": true,
    "activeChartRealtime": "subscribe-trades-while-chart-websocket-is-open",
    "todayTickStorage": "market-data/live/trades compacted after market close"
  },
  "storage": {
    "s3": {
      "rawPrefix": "market-data/raw",
      "finalPrefix": "market-data/final",
      "livePrefix": "market-data/live",
      "format": "parquet",
      "partitionKeys": ["dataset", "interval", "symbol", "year", "month", "day", "hour"]
    },
    "clickhouse": {
      "database": "market_data",
      "primaryQueryTable": "chart_candles",
      "optionalTickTable": "trade_ticks",
      "loadTradesByDefault": false
    },
    "redis": {
      "latestPriceKey": "price:{symbol}:latest",
      "liveCandleKey": "candle:{symbol}:1m:live",
      "recentCandleKey": "candles:{symbol}:{interval}",
      "activeChartSetKey": "active:charts:symbols",
      "activeChartSymbolKey": "active:charts:{symbol}"
    }
  },
  "companyToSymbol": {
    "apple": "AAPL",
    "tesla": "TSLA",
    "nvidia": "NVDA",
    "microsoft": "MSFT",
    "amazon": "AMZN",
    "google": "GOOGL",
    "alphabet": "GOOGL",
    "meta": "META",
    "amd": "AMD",
    "broadcom": "AVGO",
    "intel": "INTC",
    "qualcomm": "QCOM",
    "texas instruments": "TXN",
    "micron": "MU",
    "analog devices": "ADI",
    "marvell": "MRVL",
    "microchip": "MCHP",
    "asml": "ASML",
    "applied materials": "AMAT",
    "lam research": "LRCX",
    "kla": "KLAC",
    "tsmc": "TSM"
  }
}
