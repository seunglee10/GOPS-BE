# 역할: AWS Terraform 입력값 예시입니다.
# 사용: terraform.tfvars로 복사한 뒤 YOUR_* 값을 실제 값으로 바꿉니다.
# 주의: 이 파일에는 실제 비밀키를 넣지 않습니다.
project_name = "alfaka"
environment  = "dev"
aws_region   = "ap-northeast-2"

s3_bucket_name = "gops-market-data-<aws-account-id>-ap-northeast-2-an"
create_s3_bucket = false
manage_s3_chart_data_lifecycle = true
s3_chart_data_root_prefix      = "market-data/rebuild-20260702-lazy-v1"
s3_raw_retention_days          = 30
alpaca_secret_name = "dev/alpaca"
create_alpaca_secret = false
openai_secret_name = "/gops/prod/agent-orchestrator/openai/api-key"

eks_oidc_provider_arn = "arn:aws:iam::<aws-account-id>:oidc-provider/oidc.eks.ap-northeast-2.amazonaws.com/id/CBF812F3CD9E9F92E09BA4C33C1A1DB1"
eks_oidc_provider_url = "oidc.eks.ap-northeast-2.amazonaws.com/id/CBF812F3CD9E9F92E09BA4C33C1A1DB1"

kubernetes_namespace       = "alfaka-market-data"
kubernetes_service_account = "alfaka-market-data-sa"

msk_bootstrap_servers = "b-1.YOUR_MSK.amazonaws.com:9098,b-2.YOUR_MSK.amazonaws.com:9098"
redis_endpoint        = "YOUR_REDIS_ENDPOINT.cache.amazonaws.com"
