# 역할: GOPS React frontend를 로컬 Docker 서버로 실행합니다.
# 연결: Vite proxy가 gops-backend의 /api, /ws로 요청을 넘깁니다.
# 실행: 개발 서버를 0.0.0.0:5173으로 엽니다.
FROM node:22-alpine

WORKDIR /app

COPY apps/gops-frontend/package*.json ./
RUN npm ci

COPY apps/gops-frontend ./

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
