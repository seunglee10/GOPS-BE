# 역할: order DB-centered worker/job 이미지를 빌드합니다.
# 사용: order-outbox, migrations, reconciler가 공유합니다.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/systems/order/shared

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY systems/order/shared ./systems/order/shared
COPY systems/order/pods/order-outbox ./systems/order/pods/order-outbox
COPY systems/order/jobs/migrations ./systems/order/jobs/migrations
COPY systems/order/jobs/reconciler ./systems/order/jobs/reconciler

CMD ["python", "-u", "systems/order/pods/order-outbox/main.py"]
