# 역할: GOPS api-server pod 이미지를 빌드합니다.
# 연결: 같은 compose 안의 Redis/ClickHouse/Postgres와 market/order shared code를 읽습니다.
# 실행: uvicorn backend app을 0.0.0.0:8000으로 엽니다.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/systems/market-data/shared:/app/systems/order/shared:/app/systems/api-server/pods/api-server/gops-backend \
    ALFAKA_PACKAGES_PATH=/app/systems/market-data/shared

WORKDIR /app

COPY requirements.txt /tmp/alfaka-requirements.txt
COPY systems/api-server/pods/api-server/gops-backend/requirements.txt /tmp/gops-backend-requirements.txt
RUN pip install --no-cache-dir -r /tmp/alfaka-requirements.txt -r /tmp/gops-backend-requirements.txt

COPY systems/market-data/config ./systems/market-data/config
COPY systems/market-data/shared ./systems/market-data/shared
COPY systems/order/shared ./systems/order/shared
COPY systems/api-server/pods/api-server/gops-backend ./systems/api-server/pods/api-server/gops-backend

WORKDIR /app/systems/api-server/pods/api-server/gops-backend

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
