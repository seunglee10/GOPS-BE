# 역할: market-processor pod 이미지를 빌드합니다.
# 실행: 현재 로컬 Python stream processor를 실행합니다.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/systems/market-data/shared

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY systems/market-data/config ./config
COPY systems/market-data/shared ./systems/market-data/shared
COPY systems/market-data/pods/market-processor ./systems/market-data/pods/market-processor
COPY systems/market-data/jobs/symbol-registry-sync ./systems/market-data/jobs/symbol-registry-sync

CMD ["python", "-u", "systems/market-data/pods/market-processor/local_main.py"]
