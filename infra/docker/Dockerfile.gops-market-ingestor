# 역할: market-ingestor pod 이미지를 빌드합니다.
# 실행: Alpaca WebSocket 수집 entrypoint를 실행합니다.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/systems/market-data/shared

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY systems/market-data/config ./config
COPY systems/market-data/shared ./systems/market-data/shared
COPY systems/market-data/pods/market-ingestor ./systems/market-data/pods/market-ingestor
COPY systems/market-data/pods/news-ingestor ./systems/market-data/pods/news-ingestor

CMD ["python", "-u", "systems/market-data/pods/market-ingestor/market_stream.py"]
