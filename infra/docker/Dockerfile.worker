# 역할: Python worker 공통 이미지를 빌드합니다.
# 사용: alpaca-ingestor, stream-processor, s3-sink, backfill-worker가 같은 이미지를 씁니다.
# 설정: PYTHONPATH=/app/packages로 alfaka 패키지를 import합니다.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1     PYTHONDONTWRITEBYTECODE=1     PYTHONPATH=/app/packages

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY packages ./packages
COPY services ./services
COPY config ./config
