# 역할: market storage worker 이미지를 빌드합니다.
# 사용: clickhouse-loader pod가 ClickHouse 적재와 post-insert S3 archive를 수행합니다.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/systems/market-data/shared

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY systems/market-data/config ./systems/market-data/config
COPY systems/market-data/shared ./systems/market-data/shared
COPY systems/market-data/pods/clickhouse-loader ./systems/market-data/pods/clickhouse-loader
