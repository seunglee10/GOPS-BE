# Optional backend-local env example.
# Copy to `systems/api-server/.env` only when running the backend
# outside Docker and relying on app.core.config.read_dotenv_value().
#
# The repository root `.env` remains the canonical file for docker compose and
# most local scripts.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TIMEOUT_SECONDS=20

AUTH_ENABLED=false
AUTH_PUBLIC_BASE_URL=http://localhost:5173
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_OAUTH_STATE_TTL_SECONDS=300
AUTH_REDIS_URL=
AUTH_REDIS_KEY_PREFIX=gops:auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SECRET_NAME=

# Market-data examples are mirrored from the repository root `.env.example`.
# ALPACA_UNIVERSE is the searchable/validatable universe.
# ALPACA_COLLECTION_SYMBOL_SOURCE=universe collects full-universe bars/statuses.
# ALPACA_SYMBOLS is a legacy/local smoke seed. Frontend Watch List defaults live in the UI and sync through /api/charts/watchlist.
ALFAKA_REQUEST_CONFIG=systems/market-data/config/market-data-request.json
ALPACA_UNIVERSE=sp500
ALPACA_UNIVERSE_REGISTRY_PATH=systems/market-data/config/sp500-universe.json
ALPACA_COLLECTION_SYMBOL_SOURCE=universe
ALPACA_SYMBOLS=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA
ALPACA_MAX_TRADE_SYMBOLS=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_CREDENTIAL_SOURCE=aws-secrets-manager
ALPACA_SECRET_NAME=dev/alpaca
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
HOT_TIER_SIZE=20
HOT_TIER_FALLBACK_SCAN_LIMIT=503
ALPACA_NEWS_POLL_SECONDS=300
ALPACA_NEWS_LIMIT=50
ALPACA_NEWS_INCLUDE_CONTENT=true
ALPACA_NEWS_MAX_RETRIES=5
ALPACA_NEWS_RETRY_SLEEP_SECONDS=1
ALPACA_NEWS_RETRY_MAX_SLEEP_SECONDS=30
NEWS_S3_ARCHIVE_ENABLED=false
NEWS_BACKFILL_UNIVERSE=sp500
NEWS_BACKFILL_SYMBOLS=
NEWS_BACKFILL_DAYS=365
NEWS_BACKFILL_CHUNK_DAYS=7
NEWS_BACKFILL_LIMIT=50
NEWS_BACKFILL_INCLUDE_CONTENT=true
NEWS_BACKFILL_SORT=asc
NEWS_BACKFILL_SKIP_COMPLETED_CHUNKS=true
NEWS_BACKFILL_PUBLISH_RECENT_TO_KAFKA=true
NEWS_CLICKHOUSE_DAYS=30
NEWS_INTELLIGENCE_ENABLED=true
NEWS_INTELLIGENCE_PROVIDER=openai
NEWS_INTELLIGENCE_MODEL=gpt-5.4-mini
NEWS_INTELLIGENCE_TIMEOUT_SECONDS=30
NEWS_INTELLIGENCE_BATCH_SIZE=5
NEWS_INTELLIGENCE_MAX_POLL_INTERVAL_MS=900000
NEWS_INTELLIGENCE_MAX_POLL_RECORDS=1
NEWS_REDIS_TTL_SECONDS=1800
NEWS_REDIS_MAX_ITEMS=20
NEWS_LOCALIZATION_FALLBACK_ENABLED=true
NEWS_INTELLIGENCE_REBUILD_DAYS=30
NEWS_INTELLIGENCE_REBUILD_BATCH_SIZE=500
NEWS_INTELLIGENCE_REBUILD_MAX_ROWS=5000
NEWS_DAILY_SUMMARY_ENABLED=true
NEWS_DAILY_SUMMARY_PROVIDER=openai
NEWS_DAILY_SUMMARY_MODEL=gpt-5.4-mini
NEWS_DAILY_SUMMARY_TIMEOUT_SECONDS=20
NEWS_DAILY_SUMMARY_ARTICLE_LIMIT=50
NEWS_DAILY_REDIS_TTL_SECONDS=86400
NEWS_DAILY_REDIS_MAX_ITEMS=30
NEWS_DAILY_SUMMARY_REBUILD_DAYS=30
NEWS_DAILY_SUMMARY_REBUILD_MAX_GROUPS=1000
NEWS_DAILY_SUMMARY_REBUILD_DRY_RUN=true
AGENT_NEWS_DIRECT_FALLBACK=false

# Agent async ingress examples for backend-local runs.
AGENT_ORCHESTRATOR_URL=http://localhost:8100
AGENT_ASYNC_ANALYSIS_ENABLED=false
AGENT_SYNC_COMPAT_WAIT_ENABLED=false
AGENT_SYNC_COMPAT_WAIT_TIMEOUT_SECONDS=3
AGENT_SYNC_COMPAT_WAIT_POLL_SECONDS=0.1
AGENT_SHARED_REPORT_STORE_ENABLED=false
AGENT_ANALYSIS_QUEUE_BACKEND=memory
AGENT_ADMISSION_ENABLED=true
AGENT_ADMISSION_MAX_QUEUE_DEPTH=
AGENT_ADMISSION_MAX_PRODUCER_BUFFERED=
AGENT_ADMISSION_DEGRADE_STREAM_TO_POLL=true
AGENT_PROVIDER_BULKHEAD_DEFAULT_MAX_CONCURRENCY=50
AGENT_PROVIDER_BULKHEAD_MARKET_MAX_CONCURRENCY=100
AGENT_PROVIDER_BULKHEAD_NEWS_MAX_CONCURRENCY=100
AGENT_PROVIDER_BULKHEAD_RELATIONSHIP_MAX_CONCURRENCY=20
AGENT_PROVIDER_BULKHEAD_ACQUIRE_TIMEOUT_MS=25
AGENT_ANALYSIS_REQUESTS_TOPIC=agents.analysis-requests.v1
AGENT_DEEP_ANALYSIS_REQUESTS_TOPIC=agents.deep-analysis-requests.v1
AGENT_ANALYSIS_RESULTS_TOPIC=agents.analysis-results.v1
AGENT_QUERY_UNDERSTANDING_EVENTS_TOPIC=agents.query-understanding-events.v1
AGENT_NOTIFICATION_DECISIONS_TOPIC=agents.notification-decisions.v1
AGENT_DLQ_TOPIC=agents.dlq.v1
AGENT_INTENT_CLASSIFIER_PROVIDER=deterministic
AGENT_INTENT_CLASSIFIER_URL=http://agent-intent-classifier:8120/classify
AGENT_INTENT_CLASSIFIER_TIMEOUT_SECONDS=2.5
AGENT_QUERY_UNDERSTANDING_TIMEOUT_MS=700
AGENT_REPORT_STORE_BACKEND=memory
AGENT_REPORT_STREAM_REDIS_ENABLED=false
AGENT_REPORT_UPDATES_CHANNEL=agent.reports
AGENT_MAX_SYNTHESIS_CROSS_SIGNALS=6
AGENT_MAX_SYNTHESIS_CROSS_SIGNAL_CHARS=1800
AGENT_DEEP_ANALYSIS_ENABLED=false
