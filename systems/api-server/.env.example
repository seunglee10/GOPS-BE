# Optional backend-local env example.
# Copy to `systems/api-server/.env` only when running the backend
# outside Docker and relying on app.core.config.read_dotenv_value().
#
# The repository root `.env` remains the canonical file for docker compose and
# most local scripts.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TIMEOUT_SECONDS=20

AUTH_ENABLED=false
AUTH_PUBLIC_BASE_URL=http://localhost:5173
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_OAUTH_STATE_TTL_SECONDS=300
AUTH_REDIS_URL=
AUTH_REDIS_KEY_PREFIX=gops:auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SECRET_NAME=

# Market-data examples are mirrored from the repository root `.env.example`.
# ALPACA_UNIVERSE is the searchable/validatable universe.
# ALPACA_SYMBOLS is the always-on collection and default Watch List seed.
ALPACA_UNIVERSE=semiconductor-100
ALPACA_SYMBOLS=AAPL,MSFT,NVDA,AMZN,META,GOOGL,GOOG,TSLA,AVGO,BRK.B,JPM,BAC,GS,MS,V,MA,UNH,LLY,NVO,JNJ,MRK,ABBV,XOM,CVX,COP,SLB,COST,WMT,HD,MCD,NKE,SBUX,BA,CAT,GE,RTX,LMT,NFLX,UBER,DASH,ORCL,CRM,ADBE,NOW,SNOW,DDOG,AMD,TSM,ASML,AMAT,MU,INTC,QCOM,ARM,SMCI,PLTR,COIN,SPY,QQQ,DIA,IWM,SMH,SOXX,XLK,XLF,XLE,XLV
AGENT_NEWS_LOOKBACK_DAYS=7
AGENT_NEWS_LIMIT=12
AGENT_NEWS_DIRECT_FALLBACK=true
AGENT_NEWS_STALE_AFTER_SECONDS=21600
CLICKHOUSE_NEWS_RETENTION_DAYS=30
