{
  "description": "Default market-data universe and Alpaca subscription policy.",
  "defaultUniverse": "sp500",
  "universeRegistryPath": "systems/market-data/config/sp500-universe.json",
  "defaultSymbols": ["AAPL"],
  "symbolMetadata": {
    "AAPL": {"name": "Apple Inc.", "exchange": "NASDAQ", "market": "NASDAQ"}
  },
  "defaultChannels": ["bars", "updatedBars", "dailyBars", "statuses"],
  "activeChartChannels": ["trades"],
  "optionalActiveChannels": ["quotes"],
  "validChannels": ["bars", "updatedBars", "trades", "dailyBars", "statuses", "quotes", "corrections", "cancelErrors"],
  "symbolPattern": "^[A-Z][A-Z0-9]{0,9}(\\.[A-Z])?$",
  "dataPolicy": {
    "s3Archive": "optional-post-write-only; never a chart-serving source or ClickHouse preload input",
    "initialChartLoad": "latest-snapshot; range loads use visible-range-plus-configured-buffer",
    "avoidInitialTodayTickReplay": true,
    "activeChartRealtime": "subscribe-trades-while-chart-websocket-is-open",
    "tradeSubscriptionPlan": "active-chart + capped-watchlist + capped-hot-top",
    "defaultWatchlistTradeCap": 40,
    "defaultHotTradeCap": 10,
    "quoteUiFanout": "Redis live/closed candles are sent to /ws/quotes at maxHz=1 by default.",
    "tradeTickRetention": "realtime-only; not persisted"
  },
  "storage": {
    "s3": {
      "rootPrefix": "market-data/dev/helixho",
      "finalPrefix": "market-data/dev/helixho/final",
      "manifestPrefix": "market-data/dev/helixho/manifest",
      "backfillProcessedPrefix": "market-data/dev/helixho/backfill/processed",
      "clickhouseArchiveFormat": "parquet",
      "backfillProcessedFormat": "jsonl",
      "partitionKeys": ["dataset", "interval", "symbol", "year", "month", "day", "hour"]
    },
    "clickhouse": {
      "database": "market_data",
      "primaryQueryTable": "chart_candles",
      "symbolTable": "symbols",
      "statusTable": "market_status_events",
      "volumeProfileTable": "volume_profile_bins_1m"
    },
    "redis": {
      "keyPrefixEnv": "REDIS_KEY_PREFIX",
      "latestPriceKey": "price:{symbol}:latest",
      "liveCandleKey": "candle:{symbol}:1m:live",
      "recentCandleKey": "candles:{symbol}:{interval}",
      "activeChartSetKey": "active:charts:symbols",
      "activeChartSymbolKey": "active:charts:{symbol}",
      "watchlistSetKey": "watchlist:symbols",
      "hotSetKey": "hot:symbols",
      "hotSnapshotKey": "hot:symbols:snapshot",
      "marketStatusKey": "market:status:latest",
      "symbolStatusKey": "market:status:{symbol}:latest",
      "symbolMetadataKey": "symbols:metadata:{symbol}",
      "volumeProfileLiveKey": "volume-profile:{symbol}:1m:live"
    },
    "symbolRegistry": {
      "syncCommand": "python systems/market-data/jobs/symbol-registry-sync/main.py",
      "assetClass": "us_equity",
      "status": "active",
      "redisCache": true
    }
  },
  "companyToSymbol": {
    "apple": "AAPL",
    "microsoft": "MSFT",
    "amazon": "AMZN",
    "google": "GOOGL",
    "alphabet": "GOOGL",
    "meta": "META",
    "tesla": "TSLA"
  }
}
