{
  "description": "S&P500 bars plus on-demand realtime tick/quote subscription policy, with BTCUSD as a configured Alpaca crypto chart symbol.",
  "defaultUniverse": "sp500",
  "universeRegistryPath": "sp500-universe.json",
  "collectionSymbolSource": "universe",
  "defaultSeedSymbols": [],
  "defaultSymbols": [],
  "extraSymbols": ["BTCUSD", "XLV"],
  "universes": {},
  "symbolMetadata": {
    "BTCUSD": {
      "name": "Bitcoin / US Dollar",
      "exchange": "ALPACA_CRYPTO",
      "market": "CRYPTO",
      "assetClass": "crypto",
      "tradable": false,
      "status": "active",
      "source": "alpaca",
      "alpacaSymbol": "BTC/USD",
      "cryptoLocation": "us"
    },
    "XLV": {
      "name": "Health Care Select Sector SPDR Fund",
      "exchange": "NYSEARCA",
      "market": "US",
      "assetClass": "us_etf",
      "tradable": true,
      "status": "active",
      "source": "alpaca"
    }
  },
  "defaultChannels": ["bars", "updatedBars", "dailyBars", "statuses"],
  "activeChartChannels": ["trades", "quotes"],
  "optionalActiveChannels": [],
  "orderFlow": {
    "pinnedSymbols": ["NVDA", "AMZN", "MU", "AAPL", "GOOGL"],
    "priceBinSize": 0.01,
    "note": "phase-1 fixed pin; env ORDER_FLOW_PINNED_SYMBOLS wins"
  },
  "validChannels": ["bars", "updatedBars", "trades", "dailyBars", "statuses", "quotes", "corrections", "cancelErrors"],
  "symbolPattern": "^[A-Z][A-Z0-9]{0,9}(\\.[A-Z])?$",
  "dataPolicy": {
    "s3FinalThrough": "confirmed-canonical-candles-only",
    "initialChartLoad": "sp500-realtime-bars-plus-empty-until-user-requests-symbol-timeframe-range",
    "avoidInitialTodayTickReplay": true,
    "activeChartRealtime": "subscribe-trades-and-quotes-for-the-same-explicit-symbol-set",
    "tradeSubscriptionPlan": "explicit subscription control-plane symbols only",
    "quoteSubscriptionPlan": "quotes are attached only to symbols that already subscribe to realtime trades",
    "todayTickStorage": "Redis/WebSocket live state plus ClickHouse tick tables; processed S3 final stores candles/events and raw S3 excludes realtime trades/quotes"
  },
  "storage": {
    "s3": {
      "rawPrefix": "market-data/rebuild-20260702-lazy-v1/raw/alpaca",
      "finalPrefix": "market-data/rebuild-20260702-lazy-v1/final",
      "format": "parquet",
      "rawArchiveRole": "low-volume event/bar backup only, never queried by chart serving or materialization",
      "quoteStorage": "enabled through market.layer.quotes.v1 into ClickHouse quote_ticks; raw S3 archive excludes realtime quotes",
      "partitionKeys": ["dataset", "interval", "symbol", "year", "month", "day", "hour"]
    },
    "clickhouse": {
      "database": "market_data",
      "primaryQueryTable": "chart_candles",
      "optionalTickTable": "trade_ticks",
      "quoteTable": "quote_ticks",
      "symbolTable": "symbols",
      "statusTable": "market_status_events",
      "loadTradesByDefault": true,
      "loadQuotesByDefault": true
    },
    "redis": {
      "keyPrefixEnv": "REDIS_KEY_PREFIX",
      "recentCandleKey": "cache:candles:{symbol}:{interval}",
      "recentCandleLimit": 120,
      "liveCandleKey": "live:candle:{symbol}:{interval}",
      "latestClosedCandleKey": "latest:closed:candle:{symbol}:{interval}",
      "pendingReplaceCandleKey": "pending:replace:{symbol}:{interval}:{timestamp}",
      "candleWindowStateKey": "state:candle-window:{symbol}:{interval}:{bucket}",
      "liveTradeKey": "live:trade:{symbol}",
      "liveQuoteKey": "live:quote:{symbol}",
      "liveEventKey": "live:event:{symbol}",
      "subscriptionSetKey": "subscription:symbols",
      "subscriptionSymbolKey": "subscription:symbol:{symbol}",
      "subscriptionVersionKey": "subscription:version",
      "subscriptionEventsStream": "subscription:events",
      "feedActiveKey": "feed:active",
      "feedActiveProfileKey": "feed:active:profile",
      "feedActiveEpochKey": "feed:active:epoch",
      "feedLeaseKey": "feed:lease:{profile}",
      "feedSwitchStateKey": "feed:switch:state",
      "backfillCoverageKey": "backfill:coverage:{symbol}:{interval}",
      "symbolMetadataKey": "symbols:metadata:{symbol}"
    },
    "symbolRegistry": {
      "syncCommand": "python systems/market-data/jobs/symbol-registry-sync/main.py",
      "assetClass": "us_equity",
      "status": "active",
      "redisCache": true
    }
  },
  "companyToSymbol": {}
}
