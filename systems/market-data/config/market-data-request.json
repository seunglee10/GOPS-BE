{
  "description": "Default market-data universe and Alpaca subscription policy.",
  "defaultUniverse": "sp500",
  "universeRegistryPath": "systems/market-data/config/sp500-universe.json",
  "collectionSymbolSource": "universe",
  "defaultSeedSymbols": ["AAPL", "MSFT", "NVDA", "AMZN", "META", "GOOGL", "TSLA"],
  "defaultSymbols": [
    "AAPL", "MSFT", "NVDA", "AMZN", "META", "GOOGL", "TSLA"
  ],
  "symbolMetadata": {
    "AAPL": {"name": "Apple Inc.", "exchange": "NASDAQ", "market": "NASDAQ"},
    "MSFT": {"name": "Microsoft Corporation", "exchange": "NASDAQ", "market": "NASDAQ"},
    "NVDA": {"name": "NVIDIA Corporation", "exchange": "NASDAQ", "market": "NASDAQ"},
    "AMZN": {"name": "Amazon.com, Inc.", "exchange": "NASDAQ", "market": "NASDAQ"},
    "META": {"name": "Meta Platforms, Inc.", "exchange": "NASDAQ", "market": "NASDAQ"},
    "GOOGL": {"name": "Alphabet Inc. Class A", "exchange": "NASDAQ", "market": "NASDAQ"},
    "TSLA": {"name": "Tesla, Inc.", "exchange": "NASDAQ", "market": "NASDAQ"},
    "AMD": {"name": "Advanced Micro Devices, Inc.", "exchange": "NASDAQ", "market": "NASDAQ"},
    "AVGO": {"name": "Broadcom Inc.", "exchange": "NASDAQ", "market": "NASDAQ"},
    "AMAT": {"name": "Applied Materials, Inc.", "exchange": "NASDAQ", "market": "NASDAQ"},
    "MU": {"name": "Micron Technology, Inc.", "exchange": "NASDAQ", "market": "NASDAQ"},
    "INTC": {"name": "Intel Corporation", "exchange": "NASDAQ", "market": "NASDAQ"},
    "BRK.B": {"name": "Berkshire Hathaway Inc. Class B", "exchange": "NYSE", "market": "NYSE"},
    "JPM": {"name": "JPMorgan Chase & Co.", "exchange": "NYSE", "market": "NYSE"},
    "UNH": {"name": "UnitedHealth Group Incorporated", "exchange": "NYSE", "market": "NYSE"}
  },
  "defaultChannels": ["bars", "updatedBars", "dailyBars", "statuses"],
  "activeChartChannels": ["trades"],
  "optionalActiveChannels": ["quotes"],
  "validChannels": ["bars", "updatedBars", "trades", "dailyBars", "statuses", "quotes", "corrections", "cancelErrors"],
  "symbolPattern": "^[A-Z][A-Z0-9]{0,9}(\\.[A-Z])?$",
  "dataPolicy": {
    "s3FinalThrough": "previous-trading-day",
    "initialChartLoad": "today-1m-bars-plus-recent-clickhouse-history",
    "avoidInitialTodayTickReplay": true,
    "activeChartRealtime": "subscribe-trades-while-chart-websocket-is-open",
    "tradeSubscriptionPlan": "active-chart + watchlist + hot-top20",
    "todayTickStorage": "market-data/live/trades compacted after market close"
  },
  "storage": {
    "s3": {
      "rawPrefix": "market-data/raw/alpaca",
      "finalPrefix": "market-data/final",
      "livePrefix": "market-data/live",
      "format": "parquet",
      "partitionKeys": ["dataset", "interval", "symbol", "year", "month", "day", "hour"]
    },
    "clickhouse": {
      "database": "market_data",
      "primaryQueryTable": "chart_candles",
      "optionalTickTable": "trade_ticks",
      "symbolTable": "symbols",
      "statusTable": "market_status_events",
      "volumeProfileTable": "volume_profile_bins_1m",
      "loadTradesByDefault": false
    },
    "redis": {
      "keyPrefixEnv": "REDIS_KEY_PREFIX",
      "latestPriceKey": "price:{symbol}:latest",
      "liveCandleKey": "candle:{symbol}:1m:live",
      "recentCandleKey": "candles:{symbol}:{interval}",
      "activeChartSetKey": "active:charts:symbols",
      "activeChartSymbolKey": "active:charts:{symbol}",
      "watchlistSetKey": "watchlist:symbols",
      "hotSetKey": "hot:symbols",
      "hotSnapshotKey": "hot:symbols:snapshot",
      "marketStatusKey": "market:status:latest",
      "symbolStatusKey": "market:status:{symbol}:latest",
      "symbolMetadataKey": "symbols:metadata:{symbol}",
      "volumeProfileLiveKey": "volume-profile:{symbol}:1m:live"
    },
    "symbolRegistry": {
      "syncCommand": "python systems/market-data/jobs/symbol-registry-sync/main.py",
      "assetClass": "us_equity",
      "status": "active",
      "redisCache": true
    }
  },
  "companyToSymbol": {
    "apple": "AAPL",
    "tesla": "TSLA",
    "nvidia": "NVDA",
    "microsoft": "MSFT",
    "amazon": "AMZN",
    "google": "GOOGL",
    "alphabet": "GOOGL",
    "meta": "META",
    "amd": "AMD",
    "broadcom": "AVGO",
    "intel": "INTC",
    "qualcomm": "QCOM",
    "texas instruments": "TXN",
    "micron": "MU",
    "analog devices": "ADI",
    "marvell": "MRVL",
    "microchip": "MCHP",
    "asml": "ASML",
    "applied materials": "AMAT",
    "lam research": "LRCX",
    "kla": "KLAC",
    "tsmc": "TSM"
  }
}
