# 역할: 운영 Flink Job이 읽을 Kafka/Redis/S3 연결값 예시입니다.
# 사용: Managed Flink 또는 Flink on EKS 배포 시 실제 값으로 바꿉니다.
# 주의: 이 파일은 로컬 Python worker용이 아니라 운영 Flink Job 계약입니다.
input.topics=market.raw.bars,market.raw.updated-bars,market.raw.trades
output.ticks.topic=market.ticks.v1
output.live-candle.topic=market.candles.live.1m.v1
output.closed-candle.topic=market.candles.closed.v1
kafka.bootstrap.servers=YOUR_MSK_BOOTSTRAP_SERVERS
redis.url=redis://YOUR_REDIS_ENDPOINT:6379/0
s3.bucket=YOUR_S3_BUCKET
s3.final.prefix=market-data/dev/helixho/final
s3.live.prefix=market-data/dev/helixho/live
checkpoint.s3.path=s3://YOUR_S3_BUCKET/flink/checkpoints/market-data-normalizer
savepoint.s3.path=s3://YOUR_S3_BUCKET/flink/savepoints/market-data-normalizer
