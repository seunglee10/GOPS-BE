{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gops.local/contracts/chart-explanation.schema.json",
  "title": "GOPS Chart Explanation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "symbol",
    "interval",
    "asOf",
    "quality",
    "assetIdentity",
    "facts",
    "usedIndicators",
    "focusIds",
    "anchor",
    "news"
  ],
  "properties": {
    "version": {"const": "chart-explanation.v1"},
    "symbol": {"type": "string", "minLength": 1},
    "interval": {"type": "string", "minLength": 1},
    "asOf": {"type": "string", "minLength": 1},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "stale", "flags"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "stale": {"type": "boolean"},
        "flags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "assetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetVersion", "algorithmVersion", "inputDigest", "asOf"],
      "properties": {
        "assetVersion": {"type": ["string", "null"]},
        "algorithmVersion": {"type": ["string", "null"]},
        "inputDigest": {"type": ["string", "null"]},
        "asOf": {"type": ["string", "null"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "chartDocumentId": {"type": "string", "minLength": 1},
        "sourcePanelId": {"type": "string", "minLength": 1}
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "support", "resistance", "tradeScenario", "movingAverageCross", "selectedCandle"],
      "properties": {
        "pattern": {"type": ["object", "null"]},
        "trend": {"type": ["object", "null"]},
        "support": {"type": ["object", "null"]},
        "resistance": {"type": ["object", "null"]},
        "tradeScenario": {"type": ["object", "null"]},
        "movingAverageCross": {"type": ["object", "null"]},
        "selectedCandle": {"type": ["object", "null"]}
      }
    },
    "usedIndicators": {"type": "array", "items": {"type": "string"}},
    "focusIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "focusGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "pattern", "support", "resistance"],
      "properties": {
        "evidence": {"$ref": "#/$defs/focusIdList"},
        "levels": {"$ref": "#/$defs/focusIdList"},
        "trend": {"$ref": "#/$defs/focusIdList"},
        "pattern": {"$ref": "#/$defs/focusIdList"},
        "support": {"$ref": "#/$defs/focusIdList"},
        "resistance": {"$ref": "#/$defs/focusIdList"}
      }
    },
    "anchor": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"type": ["string", "null"]},
            "sourcePanelId": {"type": ["string", "null"]},
            "id": {"type": ["string", "null"]},
            "timestamp": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "news": {"type": "array"}
  },
  "$defs": {
    "focusIdList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
