{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gops.local/contracts/chart-analysis-asset-v1.schema.json",
  "title": "GOPS Chart Analysis Asset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetVersion", "kernelVersion", "promptVersion", "symbol", "interval", "asOf", "generatedAt", "status", "window", "coverage", "features", "layers", "chartSetup", "commentary", "buildContext"],
  "properties": {
    "assetVersion": {"const": "v1"},
    "kernelVersion": {"type": "string", "minLength": 1},
    "promptVersion": {"type": ["string", "null"]},
    "symbol": {"type": "string", "pattern": "^[A-Z0-9.-]{1,20}$"},
    "interval": {"$ref": "#/$defs/interval"},
    "asOf": {"type": "string", "format": "date-time"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready", "degraded"]},
    "window": {"$ref": "#/$defs/window"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "features": {"$ref": "#/$defs/features"},
    "layers": {"$ref": "#/$defs/layers"},
    "chartSetup": {"$ref": "#/$defs/chartSetup"},
    "commentary": {"$ref": "#/$defs/commentary"},
    "buildContext": {"$ref": "#/$defs/buildContext"}
  },
  "$defs": {
    "interval": {"enum": ["1D", "1W", "1M"]},
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["displayFrom", "displayTo", "displayBars", "lookbackBars"],
      "properties": {
        "displayFrom": {"type": "string", "format": "date-time"},
        "displayTo": {"type": "string", "format": "date-time"},
        "displayBars": {"type": "integer", "minimum": 1},
        "lookbackBars": {"type": "integer", "minimum": 1}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["expectedBars", "actualBars", "missingBars", "qualityFlags"],
      "properties": {
        "expectedBars": {"type": "integer", "minimum": 0},
        "actualBars": {"type": "integer", "minimum": 0},
        "missingBars": {"type": "integer", "minimum": 0},
        "qualityFlags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["pivots", "levels", "trends", "vp", "regime", "events", "fibCandidates"],
      "properties": {
        "pivots": {"type": "array", "items": {"type": "object"}},
        "levels": {"type": "array", "items": {"type": "object"}},
        "trends": {"type": "array", "items": {"type": "object"}},
        "vp": {"type": "object"},
        "regime": {"type": "object"},
        "events": {"type": "array", "items": {"type": "object"}},
        "fibCandidates": {"type": "array", "items": {"type": "object"}}
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "price": {"type": "number"}, "paneId": {"type": "string"},
        "symbol": {"type": "string"}, "logicalIndex": {"type": "number"},
        "value": {"type": "number"}, "interval": {"type": "string"}
      }
    },
    "drawing": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "anchors", "sourceInterval", "style", "locked", "visible", "createdBy", "sourceProposalId", "createdAt", "updatedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^ca-"},
        "type": {"enum": ["horizontalLine", "horizontalParallelLines", "trendLine", "trendParallelLines", "verticalParallelLines", "rangeBox", "fibonacciRetracement", "flagMarker", "textLabel"]},
        "anchors": {"type": "array", "items": {"$ref": "#/$defs/anchor"}, "minItems": 1, "maxItems": 3},
        "sourceInterval": {"$ref": "#/$defs/interval"},
        "style": {"type": "object"}, "label": {"type": "string"},
        "parallelLineCount": {"type": "integer", "minimum": 2, "maximum": 10},
        "locked": {"const": false}, "visible": {"type": "boolean"},
        "createdBy": {"enum": ["system", "llm"]},
        "sourceProposalId": {"type": "string", "pattern": "^chart-asset:"},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "drawings": {"type": "array", "items": {"$ref": "#/$defs/drawing"}},
    "ruleLayer": {
      "type": "object", "additionalProperties": false,
      "required": ["drawings", "meta"],
      "properties": {"drawings": {"$ref": "#/$defs/drawings"}, "meta": {"type": "object"}}
    },
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "anchorIds", "styleToken", "label", "role", "rationale"],
      "properties": {
        "tool": {"enum": ["horizontalLine", "trendLine", "trendParallelLines", "horizontalParallelLines", "verticalParallelLines", "rangeBox", "fibonacciRetracement", "flagMarker", "textLabel"]},
        "anchorIds": {"type": "array", "items": {"type": "string"}},
        "styleToken": {"enum": ["insight-primary", "insight-zone", "insight-warning", "insight-note"]},
        "label": {"type": "string"}, "role": {"enum": ["pattern", "zone", "scenario", "event", "note"]},
        "rationale": {"type": "string"}
      }
    },
    "layers": {
      "type": "object", "additionalProperties": false,
      "required": ["structure", "trend", "agent"],
      "properties": {
        "structure": {"$ref": "#/$defs/ruleLayer"}, "trend": {"$ref": "#/$defs/ruleLayer"},
        "agent": {
          "type": "object", "additionalProperties": false,
          "required": ["drawings", "intents", "rationale", "degraded", "model", "droppedIntents"],
          "properties": {
            "drawings": {"$ref": "#/$defs/drawings"},
            "intents": {"type": "array", "items": {"$ref": "#/$defs/intent"}},
            "rationale": {"type": "string"}, "degraded": {"type": "boolean"},
            "model": {"type": ["string", "null"]},
            "droppedIntents": {"type": "array", "items": {"type": "object"}},
            "meta": {"type": "object"}
          }
        }
      }
    },
    "chartSetup": {
      "type": "object", "additionalProperties": false,
      "required": ["alwaysOn", "recommended"],
      "properties": {
        "alwaysOn": {"type": "array", "prefixItems": [{"const": "volume-profile"}, {"const": "volume"}], "minItems": 2, "maxItems": 2},
        "recommended": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/recommendation"}}
      }
    },
    "recommendation": {
      "type": "object", "additionalProperties": false,
      "required": ["layer", "reason", "source"],
      "properties": {
        "layer": {"enum": ["bollinger:20:2", "macd:12:26:9", "rsi:14", "stochastic:14:3:3", "ema:20"]},
        "reason": {"type": "string", "minLength": 1}, "source": {"enum": ["rule", "llm"]}
      }
    },
    "commentary": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "keyLevels", "invalidation", "confidence", "enrichment"],
      "properties": {
        "text": {"type": "string"}, "keyLevels": {"type": "array", "items": {"type": "string"}, "maxItems": 4},
        "invalidation": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "enrichment": {"type": "null"}
      }
    },
    "buildContext": {
      "type": "object", "additionalProperties": false,
      "required": ["higherTf", "flags"],
      "properties": {"higherTf": {"type": ["object", "null"]}, "flags": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
