{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gops.local/contracts/chart-command.schema.json",
  "title": "GOPS Chart Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "target", "payload", "actor"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "chart.symbol.set",
        "chart.timeframe.set",
        "chart.viewport.set",
        "chart.layer.visibility.set",
        "chart.undo",
        "chart.redo",
        "chart.drawing.add",
        "chart.drawing.update",
        "chart.drawing.remove",
        "chart.drawing.select",
        "chart.drawing.clearSelection",
        "chart.preview.set",
        "chart.preview.toggle",
        "chart.preview.apply",
        "chart.preview.clear",
        "chart.comparison.add",
        "chart.comparison.remove",
        "chart.comparison.update",
        "chart.measurement.add"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panelId", "chartDocumentId"],
      "properties": {
        "panelId": { "type": "string" },
        "chartDocumentId": { "type": "string" }
      }
    },
    "actor": {
      "type": "string",
      "enum": ["user", "llm", "system"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "symbol": { "type": "string" },
        "timeframe": { "type": "string", "enum": ["1m", "5m", "10m", "1h", "4h", "1D", "1W", "1M"] },
        "visibleCount": { "type": "number", "minimum": 12, "maximum": 180 },
        "rightOffset": { "type": "number", "minimum": 0 },
        "layer": { "type": "string", "enum": ["candles", "volume", "ma5", "ma20", "ma60"] },
        "visible": { "type": "boolean" },
        "drawingId": { "type": "string" },
        "drawing": { "$ref": "#/$defs/drawingEntity" },
        "drawingPatch": { "type": "object", "additionalProperties": true },
        "drawingType": {
          "type": "string",
          "enum": [
            "horizontalLine",
            "trendLine",
            "verticalMarker",
            "textLabel",
            "pointMarker",
            "arrow",
            "rangeBox",
            "measurement",
            "ellipse",
            "riskRewardBox",
            "fibonacciRetracement"
          ]
        },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/drawingAnchor" }
        },
        "style": { "$ref": "#/$defs/drawingStyle" },
        "label": { "type": "string" },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "drawings"],
          "properties": {
            "id": { "type": "string" },
            "sourceProposalId": { "type": "string" },
            "drawings": {
              "type": "array",
              "items": { "$ref": "#/$defs/drawingEntity" }
            },
            "comparisons": {
              "type": "array",
              "items": { "$ref": "#/$defs/comparisonSeries" }
            },
            "visible": { "type": "boolean" },
            "rationale": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "previewVisible": { "type": "boolean" },
        "comparison": { "$ref": "#/$defs/comparisonSeries" },
        "comparisonId": { "type": "string" }
      }
    },
    "proposalId": { "type": "string" },
    "historyScope": { "type": "string", "enum": ["chartPanel", "external"] }
  },
  "$defs": {
    "drawingAnchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timestamp": { "type": "string" },
        "price": { "type": "number" },
        "paneId": { "type": "string" },
        "symbol": { "type": "string" },
        "logicalIndex": { "type": "number" },
        "value": { "type": "number" }
      }
    },
    "drawingStyle": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "color": { "type": "string" },
        "lineWidth": { "type": "number", "minimum": 1 },
        "lineDash": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 }
        },
        "fillColor": { "type": "string" },
        "textColor": { "type": "string" },
        "fontSize": { "type": "number", "minimum": 8 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "extension": { "type": "string", "enum": ["segment", "ray", "line"] }
      }
    },
    "drawingEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "anchors", "style", "visible", "createdBy"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "horizontalLine",
            "trendLine",
            "verticalMarker",
            "textLabel",
            "pointMarker",
            "arrow",
            "rangeBox",
            "measurement",
            "ellipse",
            "riskRewardBox",
            "fibonacciRetracement"
          ]
        },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/drawingAnchor" }
        },
        "style": { "$ref": "#/$defs/drawingStyle" },
        "label": { "type": "string" },
        "locked": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "createdBy": { "type": "string", "enum": ["user", "llm", "system"] },
        "sourceProposalId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "comparisonSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "symbol", "scaleMode"],
      "properties": {
        "id": { "type": "string" },
        "symbol": { "type": "string" },
        "label": { "type": "string" },
        "scaleMode": { "type": "string", "enum": ["percent"] },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["visibleRangeStart", "timestamp"] },
            "timestamp": { "type": "string" }
          }
        },
        "style": { "$ref": "#/$defs/drawingStyle" }
      }
    }
  }
}
