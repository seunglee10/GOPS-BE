# GOPS local Docker verification sample.
# Copy this file to `.env` at the repository root.
#
# Do not commit real API keys or secrets.
# Put real Alpaca keys in local `.env` only when you intentionally bypass
# Secrets Manager. For AWS/EKS and local AWS-contract runs, keep APCA_* empty
# and use ALPACA_CREDENTIAL_SOURCE=aws-secrets-manager with ALPACA_SECRET_NAME.

# -----------------------------------------------------------------------------
# Alpaca credentials
# Required for real Alpaca websocket ingestion, symbol registry sync, and
# historical backfill.
# -----------------------------------------------------------------------------
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_CREDENTIAL_SOURCE=aws-secrets-manager
ALPACA_SECRET_NAME=dev/alpaca

# -----------------------------------------------------------------------------
# OpenAI credentials
# Required for real Agent 01 chart proposal/chat. Keep this separate from
# Alpaca credentials so each teammate can decide whether to run real LLM calls.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Google OAuth / GOPS session auth
# Auth is off by default for local smoke parity. Set AUTH_ENABLED=true when you
# want /api/orders, /ws/orders, and /api/llm protected by Google login.
# AUTH_PUBLIC_BASE_URL must match the Google OAuth redirect origin.
# -----------------------------------------------------------------------------
AUTH_ENABLED=false
AUTH_PUBLIC_BASE_URL=http://localhost:5173
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_OAUTH_STATE_TTL_SECONDS=300
AUTH_REDIS_URL=
AUTH_REDIS_KEY_PREFIX=gops:auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional AWS Secrets Manager fallback when direct env values are empty.
# Secret JSON may use GOOGLE_OAUTH_CLIENT_ID/GOOGLE_OAUTH_CLIENT_SECRET or
# Google's downloaded {"web":{"client_id":"...","client_secret":"..."}} shape.
GOOGLE_OAUTH_SECRET_NAME=

# -----------------------------------------------------------------------------
# AWS / local Docker baseline
# Local Docker defaults to real AWS S3 and Secrets Manager. For long-running
# local Docker, put a restricted IAM access key in local `.env` and leave
# AWS_SESSION_TOKEN empty. Do not commit real credentials.
# -----------------------------------------------------------------------------
AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2
AWS_EC2_METADATA_DISABLED=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# S3
# Leave endpoint values empty for real AWS S3. Fill them only for local MinIO.
# Compatibility aliases are kept for older scripts.
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=
DOCKER_S3_ENDPOINT_URL=
S3_BUCKET=gops-market-data-<aws-account-id>-ap-northeast-2-an
S3_RAW_PREFIX=market-data/rebuild-20260702-lazy-v1/raw/alpaca
S3_FINAL_PREFIX=market-data/rebuild-20260702-lazy-v1/final
S3_MANIFEST_PREFIX=market-data/rebuild-20260702-lazy-v1/manifest
S3_PROCESSED_PREFIX=market-data/rebuild-20260702-lazy-v1/final
S3_PREFIX=market-data/rebuild-20260702-lazy-v1/raw/alpaca
S3_MATERIALIZE_PREFIX=market-data/rebuild-20260702-lazy-v1/final
S3_MATERIALIZE_KEYS=
S3_MATERIALIZE_MAX_OBJECTS=
S3_PROCESSED_FORMAT=parquet
S3_HISTORICAL_RAW_PARTITION_MODE=chunk
S3_HISTORICAL_PROCESSED_MANIFEST_LAYOUT=compact
S3_FLUSH_COUNT=1
S3_FLUSH_INTERVAL_SECONDS=60
S3_RAW_FLUSH_COUNT=500
S3_RAW_FLUSH_INTERVAL_SECONDS=60
S3_PUT_MAX_ATTEMPTS=3
S3_PUT_RETRY_SLEEP_SECONDS=1

# -----------------------------------------------------------------------------
# Alpaca collection
# ALPACA_UNIVERSE controls search/validation candidates.
# ALPACA_COLLECTION_SYMBOL_SOURCE=on-demand keeps startup collection empty.
# Set ALPACA_SYMBOLS only for an explicit local smoke run; it has no default symbols.
# -----------------------------------------------------------------------------
ALPACA_FEED=sip
HISTORICAL_FEED=sip
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALFAKA_REQUEST_CONFIG=systems/market-data/config/market-data-request.json
ALPACA_UNIVERSE=
ALPACA_UNIVERSE_REGISTRY_PATH=
ALPACA_COLLECTION_SYMBOL_SOURCE=on-demand
ALPACA_SYMBOLS=
ALPACA_CHANNELS=bars,updatedBars,dailyBars,statuses
ALPACA_ACTIVE_CHANNELS=trades,quotes
ALPACA_ACTIVE_TICK_SUBSCRIPTION=true
ALPACA_MAX_TRADE_SYMBOLS=
HOT_TIER_SIZE=10
HOT_TIER_FALLBACK_SCAN_LIMIT=20
ALPACA_ACTIVE_POLL_SECONDS=5
ALPACA_RECONNECT_BACKOFF_SECONDS=2
ALPACA_RECONNECT_BACKOFF_MAX_SECONDS=60
ALFAKA_PACKAGES_PATH=systems/market-data/shared

# -----------------------------------------------------------------------------
# Local Docker Kafka
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_CLIENT_ID=alfaka-alpaca-ingestor
KAFKA_INPUT_TOPIC_PREFIX=market.input
KAFKA_RAW_S3_GROUP_ID=alfaka-raw-s3-archive
KAFKA_PROCESSOR_GROUP_ID=alfaka-market-processor
KAFKA_S3_GROUP_ID=alfaka-processed-s3-sink
KAFKA_CLICKHOUSE_GROUP_ID=alfaka-clickhouse-loader
KAFKA_PROCESSOR_ENABLE_AUTO_COMMIT=false
KAFKA_S3_ENABLE_AUTO_COMMIT=false
KAFKA_CLICKHOUSE_ENABLE_AUTO_COMMIT=false

# Processed Kafka topics
KAFKA_INPUT_TRADES_TOPIC=market.input.realtime.trades.v1
KAFKA_INPUT_QUOTES_TOPIC=market.input.realtime.quotes.v1
KAFKA_INPUT_EVENTS_TOPIC=market.input.realtime.events.v1
KAFKA_INPUT_BARS_1M_TOPIC=market.input.realtime.bars.1m.v1
KAFKA_INPUT_UPDATED_BARS_1M_TOPIC=market.input.realtime.updated-bars.1m.v1
KAFKA_INPUT_DAILY_BARS_TOPIC=market.input.realtime.daily-bars.v1
KAFKA_TRADES_LAYER_TOPIC=market.layer.trades.v1
KAFKA_QUOTES_LAYER_TOPIC=market.layer.quotes.v1
KAFKA_EVENTS_LAYER_TOPIC=market.layer.events.v1
KAFKA_REALTIME_TICKS_TO_1M_TOPIC=market.realtime.ticks.to.1m.v1
KAFKA_REALTIME_TICKS_TO_5M_TOPIC=market.realtime.ticks.to.5m.v1
KAFKA_REALTIME_TICKS_TO_10M_TOPIC=market.realtime.ticks.to.10m.v1
KAFKA_REALTIME_TICKS_TO_1D_TOPIC=market.realtime.ticks.to.1d.v1
KAFKA_REALTIME_TICKS_TO_1W_TOPIC=market.realtime.ticks.to.1w.v1
KAFKA_REALTIME_TICKS_TO_1MO_TOPIC=market.realtime.ticks.to.1mo.v1
KAFKA_LIVE_CANDLE_TOPIC=market.layer.candles.live.v1
KAFKA_CLOSED_CANDLE_TOPIC=market.layer.candles.closed.v1
KAFKA_NEWS_TOPIC=market.news.alpaca.v1
KAFKA_PROCESSED_TOPICS=market.layer.candles.closed.v1,market.layer.trades.v1,market.layer.quotes.v1,market.layer.events.v1
KAFKA_CLICKHOUSE_TOPICS=market.layer.candles.closed.v1,market.layer.trades.v1,market.layer.quotes.v1,market.layer.events.v1,market.news.alpaca.v1
CANDLE_WATERMARK_GRACE_SECONDS=5
CANDLE_FLUSH_INTERVAL_SECONDS=1
PROCESSOR_RECOVERY_SYMBOLS=
PROCESSOR_RECOVERY_CLICKHOUSE_ENABLED=false

# Order Kafka topics
KAFKA_ACCOUNT_ALIAS=demo-account
KAFKA_ORDER_COMMANDS_TOPIC=orders.commands.v1
KAFKA_SUBMIT_RESULTS_TOPIC=broker.submit-results.v1
KAFKA_ORDER_EVENTS_TOPIC=broker.order-events.v1
KAFKA_DLQ_TOPIC=orders.dlq.v1

# Agent Kafka topics
AGENT_ORCHESTRATOR_URL=http://localhost:8100
AGENT_EVENT_INPUT_TOPICS=market.layer.trades.v1,market.layer.candles.closed.v1,market.layer.events.v1
AGENT_MARKET_EVENTS_TOPIC=agents.market-events.v1
AGENT_ANALYSIS_REQUESTS_TOPIC=agents.analysis-requests.v1
AGENT_ANALYSIS_RESULTS_TOPIC=agents.analysis-results.v1
AGENT_NOTIFICATION_DECISIONS_TOPIC=agents.notification-decisions.v1
AGENT_DLQ_TOPIC=agents.dlq.v1
AGENT_PUBLISH_TO_KAFKA=true

# -----------------------------------------------------------------------------
# Order database and KIS demo adapter
# Local Docker uses Postgres on compose network. Host access is localhost:5433.
# KIS_ENV=real is intentionally disabled in v1; use KIS_ENV=demo only.
# KIS demo credentials default to AWS Secrets Manager tead/gops/kis, never commit them.
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=gops_dev_password
DATABASE_URL=postgresql://gops:gops_dev_password@localhost:5433/gops
ORDER_REPOSITORY=postgres
IDEMPOTENCY_HASH_SECRET=
KIS_ENV=demo
KIS_CREDENTIAL_SOURCE=aws-secrets-manager
KIS_SECRET_NAME=tead/gops/kis
KIS_DEMO_APP_KEY=
KIS_DEMO_APP_SECRET=
KIS_DEMO_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_TOKEN_CACHE_PATH=.kis_token_cache.json
KIS_TIMEOUT_SECONDS=5
# KIS demo is the default adapter path. Uncomment only for explicit local fake smoke.
# KIS_BROKER_ADAPTER_ARGS=--fake-kis success

# -----------------------------------------------------------------------------
# Redis hot/recent cache
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=gops:market:on-demand:v1
COMPONENT_HEALTH_TTL_SECONDS=300
ACTIVE_CHART_TTL_SECONDS=45
REALTIME_CLIENT_QUEUE_SIZE=128
REALTIME_HEARTBEAT_SECONDS=15

# -----------------------------------------------------------------------------
# ClickHouse serving projection
# -----------------------------------------------------------------------------
CLICKHOUSE_HTTP_URL=http://localhost:8123
CLICKHOUSE_DATABASE=market_data
CLICKHOUSE_USER=alfaka
CLICKHOUSE_PASSWORD=alfaka
CLICKHOUSE_LOAD_TRADES=true

# -----------------------------------------------------------------------------
# Historical backfill example
# Historical values are examples. Real execution still requires Alpaca keys.
# -----------------------------------------------------------------------------
HISTORICAL_DATA_KIND=trades
HISTORICAL_SYMBOLS=AAPL,TSLA
HISTORICAL_START=2026-06-01T00:00:00Z
HISTORICAL_END=2026-06-25T13:30:00Z
HISTORICAL_TIMEFRAME=1Min
HISTORICAL_LIMIT=10000
HISTORICAL_ADJUSTMENT=split
ALLOW_NON_CANONICAL_HISTORICAL_ADJUSTMENT=false
CLICKHOUSE_REQUIRE_CANONICAL_CANDLES=true
S3_REQUIRE_CANONICAL_PROCESSED_CANDLES=true
HISTORICAL_1M_MINUTES_PER_TRADING_DAY=960
HISTORICAL_MAX_RETRIES=5
HISTORICAL_RETRY_SLEEP_SECONDS=1
HISTORICAL_RETRY_MAX_SLEEP_SECONDS=30
BACKFILL_EXECUTION_MODE=queue
BACKFILL_ALLOW_REQUESTED_MODE=false
BACKFILL_STATUS_TTL_SECONDS=604800
BACKFILL_QUEUE_BACKEND=streams
BACKFILL_STREAM_GROUP=backfill-workers
BACKFILL_STREAM_RECLAIM_IDLE_MS=600000
BACKFILL_STREAM_MAXLEN=100000
BACKFILL_MAX_ATTEMPTS=3
BACKFILL_ACTIVE_STALE_SECONDS=1800
BACKFILL_MAX_GAPFILL_1M_RANGE_HOURS=336
BACKFILL_GAPFILL_DETECT_INTERNAL=true
BACKFILL_GAPFILL_MAX_DETECT_DAYS=7
BACKFILL_GAPFILL_TIMESTAMP_LIMIT=200000
BACKFILL_INITIAL_LOAD_1M_CHUNK_DAYS=5
BACKFILL_INITIAL_LOAD_1D_CHUNK_DAYS=370
BACKFILL_INITIAL_LOAD_1M_MIN_START=2020-07-01T00:00:00Z
BACKFILL_INITIAL_LOAD_MAX_ENQUEUE=100
BACKFILL_INITIAL_LOAD_MAX_BACKLOG=1000
BACKFILL_WORKER_POLL_SECONDS=5
BACKFILL_WORKER_ONCE=false
# Optional: JSON payload consumed by `python -m alfaka.backfill.runner`.
BACKFILL_REQUEST_JSON=
COVERAGE_REPAIR_SYMBOLS=
COVERAGE_REPAIR_INTERVALS=1m,5m,10m,1D,1W,1M
COVERAGE_REPAIR_DRY_RUN=true
COVERAGE_REPAIR_FORCE=false
INITIAL_LOAD_SYMBOLS=
INITIAL_LOAD_INTERVALS=1D
INITIAL_LOAD_START=
INITIAL_LOAD_END=
INITIAL_LOAD_DRY_RUN=true
INITIAL_LOAD_FORCE=false
INITIAL_LOAD_SOURCE_PREFERENCE=coverage-first
INITIAL_LOAD_MAX_ENQUEUE=100
INITIAL_LOAD_MAX_BACKLOG=1000

# -----------------------------------------------------------------------------
# Symbol registry
# -----------------------------------------------------------------------------
SYMBOL_REGISTRY_ASSET_CLASS=us_equity
SYMBOL_REGISTRY_STATUS=active
SYMBOL_REGISTRY_REDIS_CACHE=true
SYMBOL_REGISTRY_REDIS_TTL_SECONDS=86400
SYMBOL_REGISTRY_LIMIT=

# -----------------------------------------------------------------------------
# Stream processor tuning
# -----------------------------------------------------------------------------
PROCESSOR_LOG_EVERY_N=500
VOLUME_PROFILE_PRICE_BIN_SIZE=0.05
MARKET_CALENDAR_PROVIDER=configured-nyse
MARKET_TIMEZONE=America/New_York
MARKET_OPEN_TIME=09:30
MARKET_CLOSE_TIME=16:00
MARKET_CLOSED_DATES=
MARKET_EARLY_CLOSES=

# -----------------------------------------------------------------------------
# Frontend dev/proxy
# Docker Compose sets VITE_BACKEND_TARGET=http://gops-backend:8000 in the
# frontend container. This host value is useful for local Vite.
# -----------------------------------------------------------------------------
VITE_BACKEND_TARGET=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# AWS production-only helpers
# -----------------------------------------------------------------------------
AWS_ACCOUNT_ID=<aws-account-id>
KAFKA_CLIENT_CONFIG=
