# demo | real
KIS_ENV=demo

# Korea Investment Open API keys.
KIS_DEMO_APP_KEY=
KIS_DEMO_APP_SECRET=
KIS_DEMO_ACCOUNT_NO=

KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=

# Account/product defaults.
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_HTS_ID=
KIS_CONTACT_PHONE=
KIS_MGCO_APTM_ODNO=
KIS_ORDER_SERVER_CODE=0

# API defaults.
KIS_DEMO_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_REAL_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_DEFAULT_EXCHANGE=NASD
KIS_DEFAULT_CURRENCY=USD
KIS_TIMEOUT_SECONDS=10

# Access tokens are cached locally so repeated runs do not request a token each time.
KIS_TOKEN_CACHE_PATH=.kis_token_cache.json

# The official sample sends a browser-like User-Agent.
KIS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.0.0 Safari/537.36
