# GOPS local Docker bootstrap sample.
# Copy this file to `.env` at the repository root.
# Do not commit real API keys, credentials, token caches, or secret payloads.
#
# This file mirrors the minimal local `.env` shape used by Docker Compose.
# Secret payloads should come from AWS Secrets Manager or from your local shell.

# AWS profile and region used by boto3/AWS SDKs in local containers.
AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2
AWS_PROFILE=default
AWS_SDK_LOAD_CONFIG=1
AWS_EC2_METADATA_DISABLED=true

# Alpaca credentials are read from AWS Secrets Manager when this source is used.
# Expected secret JSON fields include:
# APCA_API_KEY_ID/APCA_API_SECRET_KEY, ALPACA_API_KEY_ID/ALPACA_API_SECRET_KEY,
# or key_id/secret_key.
ALPACA_CREDENTIAL_SOURCE=aws-secrets-manager
ALPACA_SECRET_NAME=dev/alpaca

# KIS demo only. KIS_ENV=real is disabled for v1.
# Expected secret JSON fields include:
# KIS_DEMO_APP_KEY, KIS_DEMO_APP_SECRET, and KIS_DEMO_ACCOUNT_NO.
KIS_ENV=demo
KIS_CREDENTIAL_SOURCE=aws-secrets-manager
KIS_SECRET_NAME=tead/gops/kis

# Local auth is off by default.
# When AUTH_ENABLED=true, the Google OAuth secret can provide:
# GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, and AUTH_SESSION_SECRET.
AUTH_ENABLED=false
GOOGLE_OAUTH_SECRET_NAME=oauth/google

# OpenAI is not fetched directly from AWS Secrets Manager by local Docker Compose.
# Keep the example blank. Set this in `.env` or your shell only for local LLM calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
AGENT_FINAL_ANSWER_PROVIDER=openai
AGENT_MAX_REALTIME_LLM_CALLS=2
AGENT_SYNTHESIZER_TIMEOUT_SECONDS=5
AGENT_SYNTHESIS_TIMEOUT_MS=5000
AGENT_FINANCIAL_FINAL_ANSWER_PROVIDER=openai
AGENT_FINANCIAL_SYNTHESIZER_TIMEOUT_SECONDS=5
AGENT_FINANCIAL_FINAL_ANSWER_CACHE_ENABLED=true
AGENT_FINANCIAL_FINAL_ANSWER_CACHE_TTL_SECONDS=86400

# Leave DOCKER_S3_ENDPOINT_URL empty for real AWS S3.
# Use http://minio:9000 only when intentionally running the local-s3 profile.
DOCKER_S3_ENDPOINT_URL=
S3_BUCKET=gops-market-data-<aws-account-id>-ap-northeast-2-an

# ClickHouse serving projection.
CLICKHOUSE_HTTP_URL=http://localhost:8123
CLICKHOUSE_DATABASE=market_data
CLICKHOUSE_USER=alfaka
CLICKHOUSE_PASSWORD=alfaka
CLICKHOUSE_LOAD_TRADES=true
CLICKHOUSE_PROVIDER_TIMEOUT_SECONDS=8
CLICKHOUSE_PROVIDER_RETRY_ATTEMPTS=2

# On-demand historical fill. Historical values are examples.
HISTORICAL_DATA_KIND=trades
HISTORICAL_SYMBOLS=AAPL,TSLA
HISTORICAL_START=2026-06-01T00:00:00Z
HISTORICAL_END=2026-06-25T13:30:00Z
HISTORICAL_TIMEFRAME=1Min
HISTORICAL_LIMIT=10000
HISTORICAL_ADJUSTMENT=split
ALLOW_NON_CANONICAL_HISTORICAL_ADJUSTMENT=false
CLICKHOUSE_REQUIRE_CANONICAL_CANDLES=true
S3_REQUIRE_CANONICAL_PROCESSED_CANDLES=true
HISTORICAL_1M_MINUTES_PER_TRADING_DAY=960
HISTORICAL_MAX_RETRIES=5
HISTORICAL_RETRY_SLEEP_SECONDS=1
HISTORICAL_RETRY_MAX_SLEEP_SECONDS=30
ON_DEMAND_FILL_TIMEOUT_SECONDS=30
CHART_COMPARE_CACHE_ENABLED=true
CHART_COMPARE_MAX_SYMBOLS=6
CHART_COMPARE_CACHE_TTL_1D_SECONDS=60
CHART_COMPARE_CACHE_TTL_1M_SECONDS=900
CHART_COMPARE_CACHE_TTL_6M_SECONDS=21600
CHART_COMPARE_CACHE_TTL_1Y_SECONDS=21600
CHART_COMPARE_CACHE_TTL_5Y_SECONDS=86400

# Bid-Ask Volume Profile / Order Flow Profile MVP pins.
ORDER_FLOW_PINNED_SYMBOLS=NVDA,AMZN,MU,AAPL,GOOGL
ORDER_FLOW_PRICE_BIN_SIZE=0.01
ORDER_FLOW_QUOTE_REFRESH_MS=150
ORDER_FLOW_PUBLISH_THROTTLE_MS=250
ORDER_FLOW_LIVE_TTL_SECONDS=86400

# Market heatmap projection.
# Fundamentals are collected by the separate SEC fundamentals job. The API reads
# Redis `gops:fundamentals:summary:v1:{SYMBOL}` first, then ClickHouse SEC tables.
# FUNDAMENTALS_LATEST_URL/FILE are optional compatibility fallbacks.
FUNDAMENTALS_SOURCE=auto
FUNDAMENTALS_LATEST_FILE=
FUNDAMENTALS_LATEST_URL=
FUNDAMENTALS_TIMEOUT_SECONDS=2
HEATMAP_UNIVERSE=sp500
HEATMAP_UNIVERSE_REGISTRY_PATH=systems/market-data/config/sp500-heatmap-seed.json
HEATMAP_QUOTE_REFRESH_SECONDS=60
HEATMAP_LAYOUT_REFRESH_SECONDS=300
HEATMAP_CACHE_TTL_SECONDS=55
HEATMAP_STALE_CACHE_TTL_SECONDS=900

# Coverage repair job defaults.
COVERAGE_REPAIR_SYMBOLS=
COVERAGE_REPAIR_INTERVALS=1m,5m,10m,1D,1W,1M
COVERAGE_REPAIR_DRY_RUN=true

# Local compose defaults.
POSTGRES_PASSWORD=gops_dev_password

# Optional frontend stock-logo integration.
# LOGODEV_PUB_KEY is the browser-safe Logo.dev publishable key used by Vite at
# frontend build time. Do not pass LOGODEV_SECRET_KEY to the frontend build.
LOGODEV_PUB_KEY=
LOGODEV_SECRET_KEY=
VITE_LOGO_DEV_ATTRIBUTION=true

# Agent async runtime.
AGENT_ASYNC_ANALYSIS_ENABLED=true
AGENT_SHARED_REPORT_STORE_ENABLED=true
AGENT_REPORT_STORE_BACKEND=auto
AGENT_ANALYSIS_QUEUE_BACKEND=auto
